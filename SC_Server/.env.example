# SDChat Security Scanner Server - Environment Variables
# Copy this file to .env and adjust the values for your environment

# Flask Application Settings
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Database Settings
DATABASE_URI=sqlite:///data/sdchat.db
# For PostgreSQL, use something like:
# DATABASE_URI=postgresql://username:password@localhost:5432/sdchat

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-different-random-secret-key

# File Storage Paths
RULES_DIR=data/rules
REPORTS_DIR=data/reports

# API Security
VALID_API_KEYS=key1,key2,key3

# Logging
LOG_LEVEL=INFO

# Email Configuration (for report delivery)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=scanner@example.com
